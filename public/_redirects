# Netlify redirect rules for teknoify.com (public marketing site).
# Copied verbatim into the public artifact by scripts/public-artifact/build.mjs and checked by
# scripts/public-artifact/verify.mjs. See docs/marketing-rebuild/05, 06 and 07.

# --- Domain canonicalization (also configured in the Netlify UI; codified here) ---
https://www.teknoify.com/*   https://teknoify.com/:splat   301!

# --- Legacy authenticated application -> platform.teknoify.com ---
# The application frontend was removed from this repository in Phase B0 (ADR-0002). Every legacy
# application URL goes to the platform root because no platform deep-link contract exists yet
# (PLATFORM TARGET TBD). 302 so the mapping can change later without cache poisoning.
/dashboard/*                     https://platform.teknoify.com/   302
/login.html                      https://platform.teknoify.com/   302
/pages/login.html                https://platform.teknoify.com/   302
/pages/login                     https://platform.teknoify.com/   302
/pages/investment-retail.html    https://platform.teknoify.com/   302
/pages/investment-retail         https://platform.teknoify.com/   302
/pages/investment-airlines.html  https://platform.teknoify.com/   302
/pages/investment-airlines       https://platform.teknoify.com/   302

# --- Firebase password-reset action handler -> platform.teknoify.com/reset-password ---
# Firebase's Password reset template still sends its action link to /reset-password.html, and the
# Console refuses to change that action URL (EMAIL_TEMPLATE_UPDATE_NOT_ALLOWED). This bridges the old
# link to the platform's reset handler. Netlify forwards the whole query string unchanged (mode,
# oobCode, apiKey, lang, continueUrl), so nothing here reads or rebuilds the one-time code.
# Forced (!) because the static compatibility page still exists in the artifact; deleting this line
# restores it. 302, not 301, so no browser caches the mapping. Exact path only.
/reset-password.html         https://platform.teknoify.com/reset-password   302!

# --- Retired admin / application-only surfaces ---
/pages/impersonate.html      /404.html   404
/pages/impersonate           /404.html   404
/pages/unauthorized.html     /404.html   404
/pages/unauthorized          /404.html   404
/domains/*                   /404.html   404
